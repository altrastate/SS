# Optional until a hosted database is connected. The public site can render
# without this. Local CMS/admin work still needs SQLite:
# DATABASE_URL="file:./dev.db"

# Public site origin used for canonical URLs, sitemap, and Open Graph tags.
SITE_URL="http://localhost:3000"

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial administrator created by `npm run db:seed`.
# Change this password before any production deployment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Website Administrator"

# Optional SMTP settings. If these are empty, enquiries are still stored
# in the database for staff to review, and the public form explains that
# email notification is not yet configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ENQUIRY_NOTIFY_EMAIL=""

# Optional. When SMTP is configured, new contact and admissions enquiries
# notify ENQUIRY_NOTIFY_EMAIL. The public form only claims that email was
# sent after the provider accepts the message.

# Optional payments adapter. Leave empty until Jinja College approves a
# provider. Online donations stay disabled without both values.
# PAYMENTS_PROVIDER="generic"
# PAYMENTS_WEBHOOK_SECRET=""
# PAYMENTS_CHECKOUT_URL=""
# PAYMENTS_STATUS_URL=""
# PAYMENTS_SECRET=""

# Optional school-management connector. A HEAD request can test reachability.
# Student records are never imported unless a later, school-approved connector
# is implemented.
# SCHOOL_SYSTEM_NAME=""
# SCHOOL_SYSTEM_BASE_URL=""
# SCHOOL_SYSTEM_API_KEY=""
