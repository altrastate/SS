generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  passwordHash      String
  role              String               @default("editor")
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignedEnquiries Enquiry[]            @relation("EnquiryAssignee")
  notes             EnquiryNote[]
  auditLogs         AuditLog[]
  mediaAssets       MediaAsset[]
  newsRevisions     NewsRevision[]
}

model SiteSettings {
  id                          String   @id @default("default")
  schoolName                  String
  abbreviation                String
  motto                       String
  tagline                     String
  foundingYear                Int
  locationLine                String
  postalAddress               String?
  streetAddress               String?
  phone                       String?
  secondaryPhone              String?
  email                       String?
  officeHours                 String?
  mapQuery                    String?
  announcementEnabled         Boolean  @default(false)
  announcementText            String?
  announcementHref            String?
  developerAttributionEnabled Boolean  @default(true)
  developerName               String   @default("Altrastate Technologies Ltd.")
  developerUrl                String?
  metaTitle                   String
  metaDescription             String
  ogImageUrl                  String?
  vision                      String?
  mission                     String?
  inspiration                 String?
  valuesJson                  String   @default("[]")
  introText                   String?
  aboutOverview               String?
  historyText                 String?
  admissionsIntro             String?
  feesNotice                  String?
  paymentNotice               String?
  fraudNotice                 String?
  contactIntro                String?
  privacyBody                 String?
  headTeacherQuote            String?
  headTeacherName             String?
  headTeacherTitle            String   @default("Head Teacher")
  headTeacherPhotoUrl         String?
  headTeacherNamePending      Boolean  @default(true)
  contactDetailsVerified      Boolean  @default(false)
  alumniIntro                 String?
  jicobaIntro                 String?
  developmentIntro            String?
  academicsIntro              String?
  campusIntro                 String?
  enquiryRetentionDays        Int      @default(365)
  analyticsEnabled            Boolean  @default(true)
  alumniPortalEnabled         Boolean  @default(false)
  donationsEnabled            Boolean  @default(false)
  communicationsEnabled       Boolean  @default(false)
  supportIntro                String?
  parentCommsIntro            String?
  updatedAt                   DateTime @updatedAt
}

model NewsArticle {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String
  body          String
  category      String         @default("News")
  coverImageUrl String?
  coverAltText  String?
  authorName    String?
  featured      Boolean        @default(false)
  status        String         @default("draft")
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  revisions     NewsRevision[]
}

model NewsRevision {
  id        String      @id @default(cuid())
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  body      String
  status    String
  editorId  String?
  editor    User?       @relation(fields: [editorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([articleId, createdAt])
}

model EventItem {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  summary       String
  body          String
  location      String?
  startAt       DateTime?
  endAt         DateTime?
  coverImageUrl String?
  coverAltText  String?
  category      String    @default("School")
  infoUrl       String?
  cancelled     Boolean   @default(false)
  archived      Boolean   @default(false)
  audience      String    @default("public")
  status        String    @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AcademicPathway {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  levelLabel String
  summary    String
  body       String
  sortOrder  Int    @default(0)
  status     String @default("published")
}

model AcademicDepartment {
  id        String  @id @default(cuid())
  name      String
  summary   String
  body      String?
  sortOrder Int     @default(0)
  status    String  @default("draft")
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  imageUrl  String
  altText   String
  category  String?
  sortOrder Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
}

model StaffProfile {
  id          String  @id @default(cuid())
  name        String?
  title       String
  bio         String?
  photoUrl    String?
  category    String  @default("leadership")
  sortOrder   Int     @default(0)
  status      String  @default("draft")
  namePending Boolean @default(true)
}

model AlumniStory {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  summary        String
  body           String
  personName     String?
  graduationYear String?
  coverImageUrl  String?
  coverAltText   String?
  status         String         @default("draft")
  publishedAt    DateTime?
  submittedById  String?
  submittedBy    AlumniAccount? @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DevelopmentProject {
  id            String   @id @default(cuid())
  slug          String?  @unique
  title         String
  summary       String
  body          String
  publicUpdates String?
  statusLabel   String?
  coverImageUrl String?
  coverAltText  String?
  sortOrder        Int      @default(0)
  acceptDonations  Boolean  @default(false)
  status           String   @default("draft")
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  donations        Donation[]
}

model DownloadItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  category    String?
  status      String    @default("draft")
  publishedAt DateTime?
  reviewAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model FAQ {
  id        String @id @default(cuid())
  question  String
  answer    String
  category  String @default("general")
  sortOrder Int    @default(0)
  status    String @default("published")
}

model TimelineEvent {
  id          String  @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int     @default(0)
  verified    Boolean @default(false)
  status      String  @default("published")
}

model CampusLifeSection {
  id        String @id @default(cuid())
  slug      String @unique
  title     String
  summary   String
  body      String
  sortOrder Int    @default(0)
  status    String @default("published")
}

model Enquiry {
  id              String                @id @default(cuid())
  type            String
  name            String
  email           String?
  phone           String?
  category        String
  admissionLevel  String?
  message         String
  consent         Boolean
  status          String                @default("new")
  assignedToId    String?
  assignedTo      User?                 @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  respondedAt     DateTime?
  closedAt        DateTime?
  ipHash          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  notes           EnquiryNote[]
  statusHistory   EnquiryStatusChange[]
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

model EnquiryStatusChange {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  actorId    String?
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([enquiryId, createdAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  title       String
  filename    String
  url         String
  mimeType    String
  size        Int
  altText     String?
  caption     String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mimeType])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  action       String
  resourceType String
  resourceId   String?
  summary      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([path])
}

model NotificationLog {
  id         String   @id @default(cuid())
  kind       String
  resourceId String?
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())
}

model AlumniAccount {
  id                    String        @id @default(cuid())
  email                 String        @unique
  name                  String
  passwordHash          String
  graduationYear        String?
  profession            String?
  mentorshipInterest    Boolean       @default(false)
  supportInterest       Boolean       @default(false)
  publicProfileConsent  Boolean       @default(false)
  announceEmail         Boolean       @default(true)
  eventEmail            Boolean       @default(true)
  status                String        @default("pending_verification")
  emailVerifiedAt       DateTime?
  deletionRequestedAt   DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt
  stories               AlumniStory[]
  interests             EventInterest[]
}

model AuthToken {
  id        String    @id @default(cuid())
  purpose   String
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([tokenHash])
}

model EventInterest {
  id        String         @id @default(cuid())
  eventId   String?
  title     String
  name      String
  email     String
  message   String?
  consent   Boolean
  alumniId  String?
  alumni    AlumniAccount? @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
}

model Donation {
  id              String               @id @default(cuid())
  projectId       String?
  project         DevelopmentProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  donorName       String
  donorEmail      String
  amount          Int
  currency        String               @default("UGX")
  status          String               @default("created")
  provider        String
  providerRef     String?              @unique
  receiptToken    String               @unique
  idempotencyKey  String               @unique
  failureReason   String?
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  @@index([status, createdAt])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  categoriesJson String    @default("[\"general\"]")
  status         String    @default("pending")
  consentAt      DateTime
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Campaign {
  id             String               @id @default(cuid())
  title          String
  subject        String
  body           String
  category       String               @default("general")
  status         String               @default("draft")
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String?
  recipientCount Int                  @default(0)
  sentCount      Int                  @default(0)
  failCount      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  deliveries     CampaignDelivery[]
}

model CampaignDelivery {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  status     String    @default("queued")
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([campaignId, status])
}

model IntegrationLog {
  id        String   @id @default(cuid())
  provider  String
  action    String
  success   Boolean
  message   String?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}
